# ==============================================================================
# NetPulse Telkomsel Backend - Environment Configuration Example
# Salin file ini menjadi .env dan sesuaikan nilai variabel sesuai lingkungan Anda:
# cp .env.example .env
# ==============================================================================

# Port Server Express
PORT=5000
NODE_ENV=development

# JWT Authentication
# Ganti dengan secret key acak yang kuat pada production
JWT_SECRET=netpulse_telkomsel_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=24h

# PostgreSQL / Supabase Database Connection String
# 1. Format Supabase Connection String (Direct / Transaction Pooler):
#    DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# 2. Format PostgreSQL Lokal:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netpulse_telkomsel

# Supabase Client SDK (Opsional - jika menggunakan @supabase/supabase-js)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
